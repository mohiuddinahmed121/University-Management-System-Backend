model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique

  bkashPaymentId String?   @unique
  bkashTrxId     String?
  payerReference String?
  paidAt         DateTime?

  gatewayResponse Json?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId], name: "idx_payment_student")
  @@index([semesterId], name: "idx_payment_semester")
  @@index([status], name: "idx_payment_status")
  @@map("payments")
}
