model Instructor {
  id String @id @default(uuid())

  instructorId String @unique
  name         String
  email        String @unique

  contactNumber  String?
  address        String?
  specialization String?
  designation    String?

  resumeUrl      String?
  resumePublicId String?

  verificationStatus InstructorVerificationStatus @default(PENDING)
  rejectionReason    String?

  reviewedBy String?
  reviewer   User?     @relation("InstructorApprovals", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email], name: "idx_instructor_email")
  @@index([departmentId], name: "idx_instructor_department")
  @@index([verificationStatus], name: "idx_instructor_verification_status")
  @@map("instructors")
}